APP_NAME=Luizaeian API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/luizaeian
DATABASE_ECHO=false

SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Área administrativa (/admin) — usuário único.
# Gere o hash com: cd backend && python -m scripts.hash_admin_password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
